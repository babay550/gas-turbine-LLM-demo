# ============================================================
# 智谱 AI 配置（GLM 模型，OpenAI 兼容接口）
# ============================================================

# 智谱 API Key — 从 open.bigmodel.cn 获取
ZHIPU_API_KEY=your-zhipu-api-key

# 大语言模型
ZHIPU_CHAT_MODEL=glm-5

# Embedding 模型（用于向量检索）
ZHIPU_EMBEDDING_MODEL=embedding-3

# ============================================================
# vLLM 本地部署 Qwen3-32B（2×A100-80G，BF16 原版）
# ============================================================
# 安装: pip install vllm
#
# 启动命令:
#   python -m vllm.entrypoints.openai.api_server \
#     --model Qwen/Qwen3-32B \
#     --served-model-name qwen3-32b \
#     --host 0.0.0.0 \
#     --port 8000 \
#     --tensor-parallel-size 2 \
#     --gpu-memory-utilization 0.90 \
#     --max-model-len 8192 \
#     --trust-remote-code \
#     --dtype auto
#
# 验证: curl http://localhost:8000/v1/models
#
# 切换到 vLLM: 取消注释以下三行，注释掉上方的 ZHIPU 相关配置
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=empty
# LLM_MODEL_NAME=qwen3-32b

# ============================================================
# OLLAMA 本地模型配置（备用，取消注释即可切换回本地）
# ============================================================
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=empty
# LLM_MODEL_NAME=qwen2.5:72b

# ============================================================
# 数据模式
# ============================================================
# mock: 使用模拟数据（默认，无需连接真实数据库）
# real: 连接真实数据源
DATA_MODE=mock

# ============================================================
# 数据库配置
# ============================================================
# SQLite 数据库文件路径（相对于 backend/ 目录）
DATABASE_PATH=data/gasturbine.db

# 时序数据保留天数（超过此天数的数据自动清理）
DATA_RETENTION_DAYS=365

# ============================================================
# JWT 认证配置
# ============================================================
# JWT 签名密钥（生产环境务必更换为随机长字符串）
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
# Token 有效期（小时）
JWT_EXPIRE_HOURS=24
# 默认管理员密码（首次启动时创建 admin 用户）
ADMIN_DEFAULT_PASSWORD=admin123
