# ============================================================
# 智谱 AI 配置（GLM 模型，OpenAI 兼容接口）
# ============================================================

# 智谱 API Key — 从 open.bigmodel.cn 获取
ZHIPU_API_KEY=your-zhipu-api-key

# 大语言模型
ZHIPU_CHAT_MODEL=glm-5

# Embedding 模型（用于向量检索）
ZHIPU_EMBEDDING_MODEL=embedding-3

# ============================================================
# OLLAMA 本地模型配置（备用，取消注释即可切换回本地）
# ============================================================
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=empty
# LLM_MODEL_NAME=qwen2.5:72b

# ============================================================
# 数据模式
# ============================================================
# mock: 使用模拟数据（默认，无需连接真实数据库）
# real: 连接真实数据源
DATA_MODE=mock
